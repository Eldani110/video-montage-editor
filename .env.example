# ============================================================
# Montage Studio - Environment Variables Example
# ============================================================

# Firebase Authentication & Database Configuration (Optional)
# If left empty, fallback demo configurations will be used.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# External API Keys (Optional - can also be configured inside the app UI)
# Pexels API Key for HD stock video and photo searches
# VITE_PEXELS_API_KEY=
# Pixabay API Key for royalty-free stock media
# VITE_PIXABAY_API_KEY=
# Google Gemini API Key for audio transcription & AI assistance
# VITE_GEMINI_API_KEY=
