{
  "name": "video-montage-editor",
  "private": true,
  "version": "1.0.2",
  "description": "Video Montage Editor Studio",
  "author": "Daniel <daniel@thisoftcore.com>",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "desktop:start": "npm run build && electron .",
    "dist:linux": "npm run build && electron-builder --linux deb AppImage",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac zip",
    "dist:all": "npm run build && electron-builder -mwl"
  },
  "dependencies": {
    "@audio/encode-aac": "^1.2.1",
    "@huggingface/transformers": "^4.3.0",
    "electron-updater": "^6.8.11",
    "firebase": "^12.19.0",
    "lucide-react": "^1.49.0",
    "mp4-muxer": "^5.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-demuxer": "^4.0.0",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  }
}
